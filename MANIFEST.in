# Paths here are relative to this file and must NOT start with a slash -- a leading slash matches
# nothing, silently. Every line below was verified by building an sdist and listing its contents;
# `setup.py sdist` prints a "warning: no files found matching ..." line for any pattern that misses,
# which is the only feedback this file gives.

# Include important files
include README.md
include licence.txt
include requirements.txt

# Include demo image
# NOTE: this ships in the sdist but NOT in a wheel -- it sits outside every package, and
# include_package_data only reaches files inside one. NucDetectAppQT copies it from the project
# root on first run, so an installed-from-wheel copy will not find it.
include demo.tif

# Include UI files
include gui/definitions/ui/*.ui
include gui/definitions/about.txt
include gui/settings/*.ui
include gui/settings/settings.json
include gui/settings/settings.ini

# Include stylesheets and the images they reference
include gui/definitions/css/*.css
include gui/definitions/css/*.png
include gui/definitions/images/*.png

# Include the trained model. This is the file FCNMapper loads; without it an installed copy has no
# machine-learning detection at all.
include fcn/model/detector.keras
